# ====================================================
# GESTOR JURÍDICO — Variables de entorno
# Copia este archivo como .env y completa los valores
# ====================================================

# ------------------------------------------
# BASE DE DATOS (PostgreSQL)
# Usadas tanto por el contenedor db como por
# el backend via docker-compose
# ------------------------------------------
POSTGRES_DB=db_legal_administrator
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5433

# ------------------------------------------
# BACKEND (Spring Boot)
# Conexión JDBC — apunta al servicio "db"
# cuando se ejecuta dentro de Docker,
# o a localhost para ejecución local
# ------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/db_legal_administrator
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ------------------------------------------
# JWT
# Genera un secreto de al menos 256 bits (64
# caracteres hexadecimales).
# Ejemplo con OpenSSL:
#   openssl rand -hex 32
# ------------------------------------------
JWT_SECRET=your_jwt_secret_hex_64_chars

# ------------------------------------------
# PUERTOS EXPUESTOS (Docker)
# ------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173
