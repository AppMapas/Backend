{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateEcsApplicationLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-2:354245662866:log-group:/ecs/*"
    },
    {
      "Sid": "WriteEcsApplicationLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:354245662866:log-group:/ecs/*:log-stream:*"
    }
  ]
}
