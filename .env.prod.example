# Referencia para Cloud Run. El pipeline inyecta estos valores; no subir como .env.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
CLOUD_SQL_INSTANCE=your-project:us-central1:your-instance
CLOUD_SQL_IP_TYPES=PUBLIC
DB_NAME=db_legal_administrator
DB_USER=gestor_app
DB_POOL_MAX_SIZE=5
# Inyectar estos dos valores desde Secret Manager, no como sustituciones CI.
DB_PASSWORD=INJECT_FROM_SECRET_MANAGER
JWT_SECRET=INJECT_FROM_SECRET_MANAGER
FRONTEND_ALLOWED_ORIGINS=https://your-frontend.run.app
DOCUMENT_STORAGE_PROVIDER=gcs
DOCUMENT_GCS_BUCKET=your-project-documentos
DOCUMENT_MAX_FILE_SIZE=20MB
DOCUMENT_MAX_REQUEST_SIZE=21MB
GOOGLE_CALENDAR_ENABLED=false
