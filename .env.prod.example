# Referencia ECS Fargate. No incluir este archivo ni secretos en la imagen.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_HOST=legal-db.REPLACE_ENDPOINT.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_POOL_MAX_SIZE=5
DB_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem
# ECS inyecta ambos valores desde secretos de AWS Secrets Manager.
DB_PASSWORD=INJECT_FROM_SECRETS_MANAGER
JWT_SECRET=INJECT_FROM_SECRETS_MANAGER
FRONTEND_ALLOWED_ORIGINS=https://your-frontend.example.com
DOCUMENT_STORAGE_PROVIDER=s3
DOCUMENT_S3_BUCKET=legal-administrator-documents
AWS_REGION=us-east-1
DOCUMENT_MAX_FILE_SIZE=20MB
DOCUMENT_MAX_REQUEST_SIZE=21MB
GOOGLE_CALENDAR_ENABLED=false
